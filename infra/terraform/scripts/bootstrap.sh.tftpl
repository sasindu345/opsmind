#!/bin/bash
set -ex
exec > >(tee -a /var/log/opsmind-startup.log /dev/console) 2>&1
export DEBIAN_FRONTEND=noninteractive

# 1. Enable 2GB swap to ensure smooth package installation on burstable instance
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 2. Update apt and install required base packages
apt-get update -y
apt-get install -y ca-certificates curl git python3-pip python3-venv build-essential

# 3. Prepare app directory & bootstrap Python virtualenv
rm -rf /opt/opsmind /opt/opsmind.tar.gz
mkdir -p /opt/opsmind
python3 -m venv /opt/opsmind/.venv
/opt/opsmind/.venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
/opt/opsmind/.venv/bin/pip install --no-cache-dir boto3

# 4. Download app archive from S3 using IAM instance profile (with retry for IMDS credential attachment)
/opt/opsmind/.venv/bin/python -c "
import boto3, time, sys
for attempt in range(1, 11):
    try:
        print(f'Downloading package from S3 (attempt {attempt}/10)...')
        s3 = boto3.client('s3', region_name='${aws_region}')
        s3.download_file('${s3_bucket_name}', 'deploy/opsmind-app.tar.gz', '/opt/opsmind.tar.gz')
        print('Downloaded S3 artifact successfully.')
        sys.exit(0)
    except Exception as exc:
        print(f'Attempt {attempt} failed: {exc}')
        time.sleep(5)
sys.exit(1)
"

# 5. Extract archive and install all dependencies
tar -xzf /opt/opsmind.tar.gz -C /opt/opsmind
cd /opt/opsmind
/opt/opsmind/.venv/bin/pip install --no-cache-dir -r /opt/opsmind/requirements.txt

# 6. Write production environment configuration
cat > /opt/opsmind/.env << 'EOF_ENV'
DEPLOYMENT_MODE=aws
AWS_REGION=${aws_region}
SQS_QUEUE_URL=${sqs_queue_url}
SQS_DLQ_URL=${sqs_dlq_url}
DYNAMODB_TABLE_NAME=${dynamodb_table_name}
S3_BUCKET_NAME=${s3_bucket_name}
EVENTBRIDGE_BUS_NAME=${eventbridge_bus_name}
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
APP_ENV=production
LOG_LEVEL=INFO
REPORTS_DIR=/opt/opsmind/reports
EOF_ENV

mkdir -p /opt/opsmind/reports /opt/opsmind/data /opt/opsmind/artifacts /opt/opsmind/static
chown -R ubuntu:ubuntu /opt/opsmind

# 7. Create OpsMind Web API Systemd Service
cat > /etc/systemd/system/opsmind.service << 'EOF_SERVICE'
[Unit]
Description=OpsMind AIOps Web Platform & API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/opsmind
Environment=PYTHONPATH=/opt/opsmind
EnvironmentFile=/opt/opsmind/.env
ExecStart=/opt/opsmind/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF_SERVICE

# 8. Create OpsMind Queue Worker Systemd Service
cat > /etc/systemd/system/opsmind-worker.service << 'EOF_WORKER'
[Unit]
Description=OpsMind Async SQS Incident Worker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/opsmind
Environment=PYTHONPATH=/opt/opsmind
EnvironmentFile=/opt/opsmind/.env
ExecStart=/opt/opsmind/.venv/bin/python -m src.cli.opsmind_cli worker --interval 0.5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF_WORKER

# 9. Enable & start both services
systemctl daemon-reload
systemctl enable --now opsmind.service
systemctl enable --now opsmind-worker.service
echo "OpsMind deployment completed successfully."
