# Sample configuration for AWS deployment
aws_region     = "us-east-1"
environment    = "production"
app_name       = "opsmind"
instance_type  = "t4g.small"
enable_bedrock = true

# Port the API and dashboard listen on
app_port = 8000

# CIDRs allowed to reach the API and dashboard.
# Open by default so the dashboard is publicly viewable; narrow it for private
# deployments.
app_allowed_cidr_blocks = [
  "0.0.0.0/0"
]

# CIDRs allowed to reach SSH. Required, and must not be 0.0.0.0/0.
# Replace with your own address, for example "203.0.113.4/32".
# Prefer AWS SSM Session Manager, which needs no inbound SSH at all.
ssh_allowed_cidr_blocks = [
  "203.0.113.4/32"
]

# Optional SSH key
ssh_public_key = ""
