# OpsMind configuration.
#
# Copy to .env and edit. Every value below has a working default, so the only
# thing you normally need for local use is GEMINI_API_KEY. With no LLM key at
# all OpsMind still runs and falls back to deterministic heuristic analysis.

# ---------- Deployment mode ----------
# "local" uses SQLite, the local filesystem, and an in-memory queue. No AWS
# account or credentials are needed. "aws" switches to DynamoDB, S3, and SQS.
DEPLOYMENT_MODE="local"

# ---------- App ----------
APP_NAME="OpsMind"
APP_ENV="development"
LOG_LEVEL="INFO"
REPORTS_DIR="reports"
ARTIFACTS_DIR="artifacts"

# ---------- API authentication ----------
# Leave empty to disable authentication, which is the zero-setup local default.
# When set, every mutating request must send: X-API-Key: <value>
API_KEY=""

# ---------- LLM ----------
# "gemini" (free tier), "ollama" (fully local), or "bedrock" (AWS).
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini/gemini-2.0-flash"
OLLAMA_MODEL="ollama/llama3:8b"
OLLAMA_BASE_URL="http://localhost:11434"
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
LLM_TIMEOUT_SECONDS=60
# Requests per minute budget, sized for the Gemini free tier.
LLM_MAX_RPM=15

# ---------- Metric monitors ----------
# Defaults applied to a new monitor. Each monitor can override the window and
# sample count when it is created.
MONITOR_DEFAULT_WINDOW_SECONDS=900
MONITOR_DEFAULT_MIN_SAMPLES=5
# Sensitivity of anomaly-mode monitors.
MONITOR_ZSCORE_THRESHOLD=3.0
MONITOR_IQR_MULTIPLIER=1.5

# ---------- Remediation ----------
# Off by default: an approved runbook produces a clearly-labelled simulation
# until an operator deliberately opts in to real execution. The dry-run and
# human-approval gates apply either way.
REMEDIATION_EXECUTION_ENABLED=false

# ---------- Incident worker ----------
# Delay between incident queue polls in the background worker.
WORKER_POLL_INTERVAL_SECONDS=0.5

# ---------- Synthetic health probes ----------
SYNTHETIC_PROBES_ENABLED=true
# Consecutive failed probes before an incident opens (1-20).
SYNTHETIC_PROBE_TRIPWIRE=3
SYNTHETIC_PROBE_TIMEOUT_SECONDS=5.0

# ---------- Storage (local mode) ----------
DATABASE_URL="sqlite:///./opsmind.db"

# ---------- AWS (only used when DEPLOYMENT_MODE=aws) ----------
AWS_REGION="us-east-1"
SQS_QUEUE_URL=""
SQS_DLQ_URL=""
EVENTBRIDGE_BUS_NAME="default"
DYNAMODB_TABLE_NAME="opsmind-incidents"
S3_BUCKET_NAME="opsmind-artifacts"
SECRETS_MANAGER_SECRET_ID=""
CLOUDWATCH_NAMESPACE="OpsMind"

# ---------- GitHub ----------
# Repository access tokens are not configured here. A user connects a repository
# through the dashboard or POST /api/v1/repositories, and the token is stored
# through the secret manager, never in this file.
#
# Shared secret used to verify the X-Hub-Signature-256 header on webhooks.
# Only needed for the optional real-time webhook path; polling needs no
# public URL and is the primary way to connect a repository.
GITHUB_WEBHOOK_SECRET=""
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_POLLING_ENABLED=true
GITHUB_POLL_INTERVAL_SECONDS=300
GITHUB_REQUEST_TIMEOUT_SECONDS=15.0
# Stop polling a repository when fewer than this many API calls remain.
GITHUB_RATE_LIMIT_FLOOR=100
# Lines kept from the end of a failed CI job log for analysis.
GITHUB_LOG_TAIL_LINES=200
GITHUB_MAX_REPOS_PER_CYCLE=25
GITHUB_COMMIT_LOOKBACK_HOURS=24

# ---------- Local secret storage ----------
# Where secrets a user supplies at runtime are kept in local mode. Written with
# owner-only permissions, and this directory is gitignored. AWS mode uses
# Secrets Manager instead.
LOCAL_SECRETS_PATH="data/secrets.json"

# ---------- Metrics ----------
PROMETHEUS_URL="http://localhost:9090"

# ---------- Slack (optional) ----------
# Both tokens must be set for incident cards to be sent.
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_DEFAULT_CHANNEL="#incidents"
