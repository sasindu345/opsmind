# ---------- LLM ----------
# "gemini" (free tier) or "ollama" (fully local)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini/gemini-2.0-flash"
OLLAMA_MODEL="ollama/llama3:8b"
OLLAMA_BASE_URL="http://localhost:11434"
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RPM=15

# ---------- Slack ----------
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_DEFAULT_CHANNEL="#incidents"

# ---------- Storage ----------
DATABASE_URL="sqlite:///./opsmind.db"

# ---------- Metrics ----------
PROMETHEUS_URL="http://localhost:9090"

# ---------- GitHub webhooks ----------
GITHUB_WEBHOOK_SECRET=""

# ---------- App ----------
APP_ENV="development"
LOG_LEVEL="INFO"
REPORTS_DIR="reports"
